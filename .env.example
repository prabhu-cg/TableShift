# Vision provider for TableShift analysis (server-side only; never prefix with NEXT_PUBLIC_).
# Without these, the app still runs but "Analyse screenshot" reports that AI analysis isn't configured.

# "anthropic" or "openai-compatible"
VISION_PROVIDER=anthropic
VISION_API_KEY=
# Any vision-capable model id for that provider
VISION_MODEL=
# Optional. Required for non-OpenAI "openai-compatible" endpoints (OpenRouter, AI Gateway, local servers…).
# e.g. https://openrouter.ai/api/v1  or  https://ai-gateway.vercel.sh/v1
VISION_BASE_URL=
# Optional request timeout in ms (5000–120000, default 55000)
VISION_TIMEOUT_MS=
